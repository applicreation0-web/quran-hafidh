+    /** Re-audit B1': an entry owning no physical line (53:2 sits on line 526:0 owned by 53:1). */
+    @Test public void ownerlessEntryNeverCrashesHomeNorBlocksQueueOrConsolidation() throws Exception {
+        HifzPrefs prefs = new HifzPrefs(context);
+        prefs.setProgramStartDate(HifzClock.today());
+        assertTrue(CorpusLinePolicy.ownedLineIdsForRangeOnPage(
+            new VerseRef(53, 2), new VerseRef(53, 2), geometry).isEmpty());
+        List<StabilizationHalfPagePolicy.Unit> units = StabilizationHalfPagePolicy.planPage(pageLines(48));
+        assertTrue(main.edit()
+            .putString("anchoringQueue", "[{\"start\":\"53:2\",\"end\":\"53:2\",\"origin\":\"RECONSTRUCTION\",\"protocol\":\"LIGHT\",\"failures\":0},"
+                + "{\"start\":\"2:282\",\"end\":\"2:282\",\"origin\":\"RECONSTRUCTION\",\"protocol\":\"LIGHT\",\"failures\":0}]")
+            .putBoolean("anchoringQueueInitialized", true)
+            .putInt("anchoringQueueIndex", 0)
+            .putString("v6StabilizedLineIds", json(units.get(0).lineIds))
+            .putString("v6AcquiredCreditLineIds", "[]")
+            .commit());
+
+        List<ConsolidationCycleEngine.Unit> ready = prefs.stabilizedConsolidationUnits(geometry, 3);
+        assertEquals(1, ready.size());
+        assertEquals(units.get(0).lineIds, ConsolidationPhysicalUnitPolicy.decodeLineUnit(ready.get(0).id()));
+        AnchoringQueue.Entry current = prefs.currentAnchoringEntry(geometry);
+        assertNotNull(current);
+        assertEquals("2:282", current.start);
+
+        assertEquals(HifzSessionActivity.RECENT_SABQI_REVIEW, clickTodayAndReadMode());
+    }
