+  const abandon=()=>{loadGeneration++;loadActive=false;clearLoadCallbacks()};
+  window.addEventListener('pagehide',abandon,{once:true});
+  window.addEventListener('beforeunload',abandon,{once:true});
+
+  window.QsgRuntimeGuard={
+    sanitizeInitial,sanitizeState,strictPage,substantiveSvg,verifyRenderedPage,fail:showFailure,
+    get lastFailure(){return lastFailure},
+    get loading(){return loadActive},
+    get generation(){return loadGeneration},
+    get waitingForLayout(){return !!sizeWatch}
+  };
 })();
