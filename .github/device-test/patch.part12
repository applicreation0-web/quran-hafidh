+    @Test
+    fun itqanRemainsTaskWideWhenGeometryHasSeveralSegments() {
+        val task = task(HifzTrack.ITQAN)
+        val geometrySegmentCount = 4
+        var progress = HifzTrainingEngine.initial(task, geometrySegmentCount)
+        var actions = 0
+
+        while (!progress.completed) {
+            progress = HifzTrainingEngine.attemptAndAdvanceIfValid(
+                task,
+                progress,
+                correct = true,
+                segmentCount = geometrySegmentCount
+            )
+            actions += 1
+            assertTrue(actions <= 30)
+        }
+
+        assertEquals(30, actions)
+        assertEquals(0, progress.segmentIndex)
+    }
