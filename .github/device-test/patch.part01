-:root{--cream:#F7F2E8;--ink:#171715;--line:#17171533;--zoom:1}*{box-sizing:border-box}html,body{margin:0;background:var(--cream);color:var(--ink);font:16px system-ui,sans-serif;height:100%;-webkit-tap-highlight-color:transparent}button,input,select{font:inherit;color:inherit}button{border:1px solid var(--line);background:transparent;min-width:48px;min-height:48px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;padding:7px;touch-action:manipulation}button:disabled{opacity:.35;cursor:default}button.active{background:var(--ink);color:var(--cream)}button:focus-visible{outline:2px solid var(--ink);outline-offset:2px}.capsule{border-radius:30px;padding:8px 18px}.text{border:0;border-radius:12px}.small{font-size:13px}.muted{opacity:.66}.row{display:flex;align-items:center;gap:6px}.spread{justify-content:space-between}.wrap{flex-wrap:wrap}h2{font:24px Georgia,serif;margin:8px 0 18px}p{line-height:1.5}#viewport{height:100%;width:100%;overflow:auto;overscroll-behavior:contain;scrollbar-width:none;touch-action:pan-x pan-y pinch-zoom}#pagebox{min-height:100%;display:flex;align-items:center;justify-content:center;position:relative}#mushaf{width:calc(min(100vw,64vh)*var(--zoom));flex:none}#mushaf>svg{display:block;width:100%;height:auto;max-height:none}#mushaf .ayahPolygon{cursor:pointer;pointer-events:all;fill:#171715;fill-opacity:0;transition:fill-opacity .18s}#mushaf .ayahPolygon.selected{fill-opacity:.08}#mushaf .ayahPolygon.audio{fill-opacity:.12}#mushaf .masklayer{pointer-events:none}#top,#bottom{position:fixed;left:8px;right:8px;z-index:3;transition:opacity .2s;pointer-events:auto}#top{top:4px}#bottom{bottom:4px}body.hidden #top,body.hidden #bottom{opacity:0;pointer-events:none}#title{font-size:14px;text-align:center;background:#f7f2e8cc;border-radius:40px;padding:8px 16px}#progress{flex:1;height:28px;accent-color:var(--ink);margin:0}input[type=range]{height:2px;accent-color:var(--ink)}#tools{justify-content:space-evenly}.counter{font-size:12px;margin:0 8px}.sheet{position:fixed;inset:auto 0 0;max-height:85%;overflow:auto;background:var(--cream);z-index:7;padding:16px 18px 22px;border-top:1px solid var(--line);border-radius:24px 24px 0 0;box-shadow:0 -8px 35px #0000000a}#shade{position:fixed;inset:0;background:#00000018;z-index:6} [hidden]{display:none!important}#notice{position:fixed;bottom:125px;left:20px;right:20px;z-index:9;text-align:center;background:var(--cream);padding:12px;border-radius:25px;border:1px solid var(--line)}input[type=number],select{padding:12px;border:1px solid var(--line);border-radius:20px;background:transparent;max-width:100%;min-height:48px}.field{display:flex;gap:10px;align-items:center;margin:12px 0}.field label{min-width:65px}.field input,.field select{flex:1;width:100%}.listitem{border-bottom:1px solid var(--line);padding:9px 0}.listitem .text{flex:1;justify-content:flex-start;text-align:left;border-radius:0}.memsummary{background:#f7f2e8ed;border-radius:22px;padding:8px 12px;margin-bottom:5px}#memcontrols{padding:6px 0}.memsummary #stepLabel{font-size:14px;font-weight:600}#memcontrols button{font-size:13px}.memlabel{font-size:12px;opacity:.7}svg.icon{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}#sheetBody .row{margin:8px 0}#sheetBody button{flex-shrink:0}body.eink *,body.eink *::before,body.eink *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}body.eink #shade{background:transparent}body.eink .sheet{box-shadow:none;border:2px solid var(--ink)}
