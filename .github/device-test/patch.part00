+    const ids=Array.isArray(st.segmentLineIds)?st.segmentLineIds:[],id=ids.at(-1),key=Number(st.segmentIndex)+':'+String(st.segmentPage||'')+':'+ids.join(',');
+    if(id&&key!==hifzViewportKey){hifzViewportKey=key;const line=lineById(id);if(line){revealLine(line,true);return}}
+   }
+   if(changed)requestAnimationFrame(()=>visual('PAGE'));
+  })
+ }
