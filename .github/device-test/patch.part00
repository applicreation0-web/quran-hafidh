+ function syncHifzOcclusion(st,allowScroll=true){
+  requestAnimationFrame(()=>{
+   if(!memory||!st?.valid)return;
+   const box=$('pagebox'),bottom=$('bottom');if(!box||!bottom)return;
+   const oldPad=parseFloat(box.style.paddingBottom)||0,pad=Math.max(oldPad,bottom.offsetHeight);
+   let changed=false;if(pad>oldPad){box.style.paddingBottom=pad+'px';changed=true}
