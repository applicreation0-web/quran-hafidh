+  const clearPendingTimer=()=>{
+    if(pendingPageTimer!==null){clearTimeout(pendingPageTimer);pendingPageTimer=null}
+  };
+  const clearFrames=()=>{
+    if(frameOne!==null){cancelAnimationFrame(frameOne);frameOne=null}
+    if(frameTwo!==null){cancelAnimationFrame(frameTwo);frameTwo=null}
+  };
+  const clearSizeWatch=()=>{
+    if(sizeWatch){try{sizeWatch.disconnect()}catch(_){}sizeWatch=null}
+  };
+  const clearLoadCallbacks=()=>{clearPendingTimer();clearFrames();clearSizeWatch()};
+  const isCurrent=generation=>loadActive&&generation===loadGeneration;
+
+  function showFailure(message,error,generation=loadGeneration){
+    if(generation!==loadGeneration)return false;
+    clearLoadCallbacks();
+    loadActive=false;
     lastFailure=message||'Le Muṣḥaf n’a pas pu être affiché.';
     console.error(lastFailure,error||'');
