 window.audioEvent=function(e){playing=e.state==='playing';$('audio').textContent=playing?'❚❚':'▶';document.querySelectorAll('.ayahPolygon').forEach(p=>p.classList.toggle('audio',playing&&p.dataset.verse===e.surah+':'+e.ayah));if(e.state==='cycle_complete'){const s=currentSession(),step=s&&P.current(s);const refs=step?refsFor(step.lines):[];if(audioCountsProgress&&refs.at(-1)===e.surah+':'+e.ayah){void recordFreeRepetition(s,true,'audio').then(advanced=>{if(!advanced)nextAudio()})}else nextAudio()}if(e.state==='download_required'){audioQueue=[];audioCountsProgress=false;const s=currentSession();if(s&&s.withAudio){P.disableAudio(s);save();renderMemory()}notice('Audio local manquant — la séance continue sans audio.')}if(e.state==='download_start')notice('Téléchargement audio démarré…');if(e.state==='download_progress')notice('Téléchargement audio '+e.done+' / '+e.total);if(e.state==='download_complete')notice('Audio local disponible hors ligne ✓');if(e.state==='delete_complete')notice('Audio local supprimé');if(e.state==='download_error'||e.state==='error')notice(e.message||'Audio indisponible')};
 window.setOcclusion=function(px){occlusion=px;$('viewport').style.paddingBottom=px+'px';if(px===0)$('viewport').style.paddingBottom='0px'};
 window.einkCleanerRuns=0;
