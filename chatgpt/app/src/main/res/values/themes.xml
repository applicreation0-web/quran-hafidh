<resources>
    <style name="Theme.QuranSafeguard" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/safeguard_ivory</item>
        <item name="android:navigationBarColor">@color/safeguard_ivory</item>
        <item name="android:colorAccent">@color/safeguard_gold</item>
        <item name="android:windowAnimationStyle">@style/Animation.QuranSafeguard</item>
    </style>

    <style name="Animation.QuranSafeguard" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/safeguard_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/safeguard_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/safeguard_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/safeguard_close_exit</item>
    </style>
</resources>
